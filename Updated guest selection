<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>SeatPlanner</title><style>
:root{font-family:system-ui,-apple-system,sans-serif;color:#17243a;background:#f3f6fb}*{box-sizing:border-box}body{margin:0}header{background:#182c55;color:white;padding:24px 18px}header h1{margin:0;font-size:28px}header p{margin:6px 0 0;color:#d5e1fb}main{max-width:780px;margin:20px auto;padding:0 14px}.panel{background:white;border-radius:18px;padding:20px;margin-bottom:16px;box-shadow:0 3px 18px #1d376012}h2{font-size:19px;margin:0 0 14px}label{display:block;font-weight:650;margin:12px 0 6px}input,select,button{font:inherit}input,select{width:100%;padding:12px;border:1px solid #b8c5d8;border-radius:10px;background:white}button{border:0;border-radius:11px;padding:12px 15px;background:#215fd0;color:white;font-weight:700;cursor:pointer}button.secondary{background:#e6edfa;color:#1b3766}button:disabled{opacity:.5;cursor:not-allowed}.row{display:flex;gap:9px;flex-wrap:wrap}.row>*{flex:1}.hint{color:#5b6980;font-size:13px;margin:7px 0}.mode{flex:1 1 145px}.mode.active{background:#163e89;color:white}.seat-grid{display:grid;grid-template-columns:repeat(var(--cols,4),minmax(0,1fr));gap:9px;margin-top:16px}.seat{min-height:68px;padding:9px 5px;background:#e7eefb;color:#173660;border:2px solid transparent;overflow-wrap:anywhere}.seat.taken{background:#d4f4e1;color:#165538}.seat.selected{border-color:#f4a340}.seat small{display:block;font-size:11px;font-weight:500}.hidden{display:none}footer{text-align:center;padding:16px;color:#69778c}#status{font-weight:650;color:#215a42}.guest-list{display:flex;flex-wrap:wrap;gap:7px;margin-top:12px}.chip{padding:7px 10px;border-radius:99px;background:#edf2fb;font-size:13px}@media(max-width:420px){.panel{padding:15px}.seat-grid{gap:6px}.seat{font-size:12px;min-height:60px}}
</style></head><body><header><div style="max-width:780px;margin:auto"><h1>🪑 SeatPlanner</h1><p>Plan together, sit happy.</p></div></header><main>
<section class="panel"><h2>1. Plan your outing</h2><label for="event">Event name</label><input id="event" value="Friday Night Out" maxlength="80"><label for="venue">Where are you going?</label><select id="venue"><option value="restaurant">Restaurant</option><option value="movies">Movies or theater</option><option value="event">Event</option><option value="car">Car ride</option></select><label for="layout">Seating layout</label><select id="layout"></select></section>
<section class="panel"><h2>2. Who's coming?</h2><label for="count">Exact number of guests</label><input id="count" type="number" min="1" max="100" step="1" value="6" inputmode="numeric"><p class="hint">Choose 1 to 100 guests. The seating map expands automatically when needed.</p><label for="names">Guest names (one per line)</label><textarea id="names" rows="7" style="width:100%;padding:12px;border:1px solid #b8c5d8;border-radius:10px;font:inherit" placeholder="Enter guest names, one per line"></textarea><div class="row" style="margin-top:10px"><button id="fill" class="secondary">Fill missing names</button><button id="clear" class="secondary">Clear names</button></div><div id="guestList" class="guest-list"></div></section>
<section class="panel"><h2>3. Choose a seating method</h2><div class="row"><button class="mode active" data-mode="random">🎲 Random</button><button class="mode secondary" data-mode="self">👆 Self-selection</button><button class="mode secondary" data-mode="organizer">👑 Organizer</button></div><p id="instructions" class="hint"></p><div id="pickerWrap" class="hidden"><label for="picker">Choose a guest</label><select id="picker"></select></div><div class="row" style="margin-top:12px"><button id="shuffle">Shuffle seats</button><button id="undo" class="secondary">Undo last</button><button id="reset" class="secondary">Reset seats</button></div></section>
<section class="panel"><h2>4. Seating assignments</h2><p id="status" aria-live="polite"></p><div id="map" class="seat-grid"></div><div class="row" style="margin-top:14px"><button id="copy" class="secondary">Copy assignments</button><button id="share" class="secondary">Share</button></div></section>
</main><footer>SeatPlanner • Plan together, sit happy.</footer><script>
'use strict';
const $=id=>document.getElementById(id);
const layouts={restaurant:[['Round table (8)',8,4],['Long table (12)',12,4],['Booths (4)',4,2]],movies:[['Theater row (10)',10,5],['Theater row (16)',16,8]],event:[['Banquet table (10)',10,5],['Auditorium row (12)',12,6]],car:[['Standard car (5)',5,2],['SUV (7)',7,3],['Van (12)',12,4]]};
const state={venue:'restaurant',layout:0,count:6,names:[],mode:'random',assign:{},history:[]};
function config(){return layouts[state.venue][state.layout]}
function seats(){return Math.max(state.count,config()[1])}
function guestNames(){return Array.from({length:state.count},(_,i)=>state.names[i]?.trim()||`Guest ${i+1}`)}
function updateNames(){const entered=$('names').value.split(/\r?\n/).map(s=>s.trim());state.names=entered.slice(0,state.count);}
function resetSeats(){state.assign={};state.history=[];render()}
function renderLayouts(){const opts=layouts[state.venue];$('layout').innerHTML=opts.map((x,i)=>`<option value="${i}">${x[0]}</option>`).join('');$('layout').value=state.layout}
function render(){const guests=guestNames();$('count').value=state.count;$('guestList').innerHTML='';guests.forEach(n=>{const chip=document.createElement('span');chip.className='chip';chip.textContent=n;$('guestList').appendChild(chip)});document.querySelectorAll('[data-mode]').forEach(b=>{const active=b.dataset.mode===state.mode;b.classList.toggle('active',active);b.classList.toggle('secondary',!active)});$('instructions').textContent={random:'Shuffle all guests into seats automatically.',self:'Choose your name, then tap an empty seat.',organizer:'Choose a guest, then tap the seat you want to assign.'}[state.mode];$('pickerWrap').classList.toggle('hidden',state.mode==='random');$('shuffle').classList.toggle('hidden',state.mode!=='random');$('picker').innerHTML='';guests.forEach((n,i)=>{const opt=document.createElement('option');opt.value=i;opt.textContent=n;$('picker').appendChild(opt)});const used=new Set(Object.values(state.assign));for(const opt of $('picker').options)opt.disabled=used.has(Number(opt.value));const first=[...$('picker').options].find(o=>!o.disabled);if(first)$('picker').value=first.value;const total=seats();$('map').style.setProperty('--cols',Math.min(config()[2],total));$('map').innerHTML='';for(let i=0;i<total;i++){const b=document.createElement('button');b.className='seat'+(state.assign[i]!==undefined?' taken':'');const who=state.assign[i];b.textContent=who===undefined?`Seat ${i+1}`:guests[who];const small=document.createElement('small');small.textContent=who===undefined?'Available':`Seat ${i+1}`;b.appendChild(small);b.onclick=()=>clickSeat(i);$('map').appendChild(b)}$('status').textContent=`${Object.keys(state.assign).length} of ${state.count} guests seated • ${total} seats available`;$('undo').disabled=!state.history.length}
function clickSeat(i){if(state.mode==='random')return;const selected=Number($('picker').value);if(!Number.isInteger(selected)||selected<0||selected>=state.count)return;state.history.push({...state.assign});for(const [seat,guest] of Object.entries(state.assign))if(guest===selected)delete state.assign[seat];if(state.assign[i]===undefined)state.assign[i]=selected;else if(state.assign[i]!==selected){state.assign[i]=selected}render()}
function shuffle(){const guests=Array.from({length:state.count},(_,i)=>i);for(let i=guests.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[guests[i],guests[j]]=[guests[j],guests[i]]}state.history.push({...state.assign});state.assign={};guests.forEach((g,i)=>state.assign[i]=g);render()}
function summary(){const guests=guestNames();return `${$('event').value||'My outing'}\n${config()[0]}\n`+Array.from({length:seats()},(_,i)=>`Seat ${i+1}: ${state.assign[i]===undefined?'Available':guests[state.assign[i]]}`).join('\n')}
$('venue').onchange=e=>{state.venue=e.target.value;state.layout=0;renderLayouts();resetSeats()};$('layout').onchange=e=>{state.layout=Number(e.target.value);resetSeats()};$('count').oninput=e=>{const v=Number(e.target.value);if(!Number.isInteger(v)||v<1||v>100)return;state.count=v;state.names=state.names.slice(0,v);resetSeats()};$('names').oninput=()=>{updateNames();render()};$('fill').onclick=()=>{$('names').value=guestNames().join('\n');updateNames();render()};$('clear').onclick=()=>{$('names').value='';state.names=[];render()};document.querySelectorAll('[data-mode]').forEach(b=>b.onclick=()=>{state.mode=b.dataset.mode;resetSeats()});$('shuffle').onclick=shuffle;$('undo').onclick=()=>{if(state.history.length){state.assign=state.history.pop();render()}};$('reset').onclick=resetSeats;$('copy').onclick=async()=>{try{await navigator.clipboard.writeText(summary());$('status').textContent='Assignments copied!'}catch{window.prompt('Copy these assignments:',summary())}};$('share').onclick=async()=>{if(navigator.share){try{await navigator.share({title:'SeatPlanner assignments',text:summary()})}catch{}}else $('copy').click()};renderLayouts();render();
</script></body></html>
